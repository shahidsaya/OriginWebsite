# ============================================================
# Origin Sperm Bank — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# MongoDB connection string
# Local dev:   mongodb://localhost:27017/origin
# Atlas:       mongodb+srv://user:password@cluster.mongodb.net/origin
APOS_MONGODB_URI=mongodb://localhost:27017/origin

# AWS S3 storage (for uploaded images and documents)
APOS_S3_BUCKET=your-s3-bucket-name
APOS_S3_KEY=your-aws-access-key-id
APOS_S3_SECRET=your-aws-secret-access-key
APOS_S3_ENDPOINT=https://s3.amazonaws.com
APOS_S3_REGION=us-east-1

# CDN URL for serving uploaded files (optional)
# Leave blank to serve directly from S3
APOS_CDN_URL=

# Facebook Pixel (optional)
FB_ACCESS_TOKEN=
FB_PIXEL_ID=

# Contact form endpoint (optional)
GF_FORM_ENDPOINT=
