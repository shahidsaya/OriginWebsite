{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm install && npm run copy-css-images && npm run tailwind-build:production"
  },
  "deploy": {
    "startCommand": "APOS_BUNDLE=1 node app.js",
    "healthcheckPath": "/",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
