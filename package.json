{
  "name": "origin",
  "version": "1.0.0",
  "description": "Origin Sperm Bank",
  "author": "Art & Science",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "build": "npm run copy-css-images && npm run tailwind-build:production && APOS_BUNDLE=1 node app apostrophe:generation",
    "dev": "nodemon app.js & npm run tailwind-dev",
    "tailwind-dev": "cross-env TAILWIND_MODE=watch NODE_ENV=development tailwindcss -i tailwind.css -o lib/modules/apostrophe-assets/public/css/tailwind.css -w",
    "tailwind-build:development": "cross-env TAILWIND_MODE=build NODE_ENV=development tailwindcss -i tailwind.css -o lib/modules/apostrophe-assets/public/css/tailwind.css",
    "tailwind-build:production": "TAILWIND_MODE=build NODE_ENV=production tailwindcss -i tailwind.css -o lib/modules/apostrophe-assets/public/css/tailwind.css --minify",
    "copy-css-images": "mkdir -p public/css/images && cp -R static/images/* public/css/images/",
    "docker-backup-content": "docker-compose exec apostrophe ./scripts/docker-backup-content",
    "docker-restore-content": "docker-compose exec apostrophe ./scripts/docker-restore-content"
  },
  "engines": {
    "node": ">=16"
  },
  "repository": {
    "type": "git",
    "url": ""
  },
  "dependencies": {
    "@tailwindcss/aspect-ratio": "^0.2.2",
    "@tailwindcss/forms": "^0.5.0",
    "@tailwindcss/line-clamp": "^0.2.2",
    "apostrophe": "^2.220.2",
    "apostrophe-open-graph": "^1.1.6",
    "apostrophe-redirects": "^2.3.2",
    "apostrophe-rich-text-permalinks": "^2.0.5",
    "apostrophe-seo": "^1.5.0",
    "apostrophe-site-map": "^2.5.3",
    "apostrophe-workflow": "^2.39.7",
    "autoprefixer": "^10.4.5",
    "copyfiles": "^2.4.1",
    "cross-env": "^7.0.3",
    "dotenv": "^10.0.0",
    "express-basic-auth": "^1.2.1",
    "facebook-nodejs-business-sdk": "^12.0.1",
    "html-to-text": "^8.0.0",
    "lodash": "^4.17.21",
    "mongodb": "^6.0.0",
    "nodemon": "^2.0.12",
    "postcss": "^8.4.12",
    "postcss-cli": "^8.3.1",
    "postcss-import": "^14.1.0",
    "request-promise": "^4.2.6",
    "tailwindcss": "^3.0.24"
  },
  "nodemonConfig": {
    "verbose": true,
    "ignore": [
      "locales/*.json",
      "public/uploads",
      "data"
    ],
    "engines": {
      "node": "16.15.0",
      "npm": "8.5.5"
    },
    "watch": [
      "app.js",
      "lib/",
      "views/"
    ],
    "ext": "json,js,html,css,less"
  },
  "devDependencies": {
    "tailwind-scrollbar": "^1.3.1"
  }
}
